/* ===================================================================
   EL BUFFET DE ALEJANDRO - SISTEMA GOURMET & BUFFET ESCOLAR
   =================================================================== */

QMainWindow, QDialog, QWidget#LoginWindow, QWidget#CajeroWindow, QWidget#AdminWindow {
    background-color: #FBF8F3;
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    color: #2D2424;
}

QFrame#cardLogin, QFrame#cardRegister, QFrame#cardNotice, QFrame#frameHeader, QFrame#frameProductCard, QFrame#cardReceipt {
    background-color: #FFFFFF;
    border: 1px solid #E6DCCD;
    border-radius: 12px;
}

QFrame#frameHeader {
    background-color: #2E151B;
    border-radius: 10px;
    padding: 10px;
}

QLabel#lblLogoTitle {
    color: #2E151B;
    font-size: 22px;
    font-weight: bold;
}

QLabel#lblHeaderTitle {
    color: #FFFFFF;
    font-size: 19px;
    font-weight: bold;
}

QLabel#lblHeaderSubtitle {
    color: #E5B842;
    font-size: 13px;
    font-weight: 500;
}

/* PESTAÑAS (QTabWidget) */
QTabWidget::pane {
    border: 1px solid #DFD5C3;
    background: #FFFFFF;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background: #F2EBE0;
    color: #554438;
    padding: 11px 20px;
    font-weight: bold;
    font-size: 13px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background: #2E151B;
    color: #F1C40F;
}

QTabBar::tab:hover:!selected {
    background: #E5DAC9;
}

/* BOTONES PRINCIPALES */
QPushButton {
    background-color: #2E151B;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #4A222C;
}

QPushButton:pressed {
    background-color: #1A0B0E;
}

QPushButton:disabled {
    background-color: #CCCCCC;
    color: #777777;
}

QPushButton#btnGoRegister {
    background-color: transparent;
    color: #B38600;
    text-decoration: underline;
    font-weight: bold;
    border: none;
    padding: 2px;
}

QPushButton#btnGoRegister:hover {
    color: #2E151B;
}

QPushButton#btnAddToCart, QPushButton#btnCheckout, QPushButton#btnProcederPago, QPushButton#btnConfirmarPedido {
    background-color: #27AE60;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
    border-radius: 8px;
}

QPushButton#btnAddToCart:hover, QPushButton#btnCheckout:hover, QPushButton#btnProcederPago:hover, QPushButton#btnConfirmarPedido:hover {
    background-color: #1E8449;
}

QPushButton#btnVaciarCarrito, QPushButton#btnEliminarProd, QPushButton#btnCancelarPedido {
    background-color: #E74C3C;
    color: #FFFFFF;
}

QPushButton#btnVaciarCarrito:hover, QPushButton#btnEliminarProd:hover, QPushButton#btnCancelarPedido:hover {
    background-color: #C0392B;
}

QPushButton#btnModificarCantidad {
    background-color: #2980B9;
    color: #FFFFFF;
}

QPushButton#btnModificarCantidad:hover {
    background-color: #1F618D;
}

QPushButton#btnMinus, QPushButton#btnPlus {
    background-color: #EFE8DC;
    color: #2E151B;
    font-size: 16px;
    font-weight: bold;
    border-radius: 6px;
    padding: 4px 12px;
}

QPushButton#btnMinus:hover, QPushButton#btnPlus:hover {
    background-color: #DCCFB8;
}

/* TARJETAS DE PRODUCTOS EN PESTAÑAS */
QFrame#cardProduct {
    background-color: #FFFFFF;
    border: 1px solid #EAE1D1;
    border-radius: 10px;
}

QLabel#lblCardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #2E151B;
}

QLabel#lblCardPrice {
    font-size: 15px;
    font-weight: bold;
    color: #B78103;
}

QLabel#lblCardDesc {
    font-size: 12px;
    color: #666666;
}

/* INPUTS Y SELECTORES */
QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #D5C8B4;
    border-radius: 6px;
    padding: 8px 10px;
    background-color: #FFFFFF;
    color: #2D2424;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #2E151B;
}

/* GROUPBOX ESCOLAR */
QGroupBox {
    font-size: 13px;
    font-weight: bold;
    color: #2E151B;
    border: 1px solid #DFD5C3;
    border-radius: 8px;
    margin-top: 18px;
    padding-top: 14px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #FFFFFF;
}

/* TABLAS */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5DAC9;
    border-radius: 8px;
    gridline-color: #F5EFE6;
    font-size: 13px;
    selection-background-color: #F9E79F;
    selection-color: #2E151B;
}

QHeaderView::section {
    background-color: #2E151B;
    color: #F1C40F;
    font-weight: bold;
    padding: 8px;
    border: none;
}

/* CHECKBOX */
QCheckBox {
    font-size: 12px;
    color: #444444;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}
